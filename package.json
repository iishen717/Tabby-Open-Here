{
  "name": "tabby-open-here",
  "version": "1.0.0",
  "description": "Open Here 插件 - 地址栏 tabby + 文件夹右键菜单，在 Tabby 中打开当前目录",
  "keywords": ["tabby-plugin"],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "webpack --progress --color --watch",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File launcher/build.ps1",
    "test": "tsx --test tests/oh-util.test.ts tests/oh-pending.test.ts tests/oh-i18n.test.ts tests/oh-win.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": ["dist"],
  "author": "iishen717",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iishen717/Tabby-Open-Here.git"
  },
  "homepage": "https://github.com/iishen717/Tabby-Open-Here#readme",
  "bugs": {
    "url": "https://github.com/iishen717/Tabby-Open-Here/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@angular/animations": "^9.1.13",
    "@angular/common": "^9.1.13",
    "@angular/core": "^9.1.13",
    "@angular/forms": "^9.1.13",
    "@angular/platform-browser": "^9.1.13",
    "@angular/platform-browser-dynamic": "^9.1.13",
    "@types/node": "^22.13.10",
    "@types/webpack-env": "^1.18.8",
    "apply-loader": "^2.0.0",
    "css-loader": "^7.1.2",
    "rxjs": "^6.6.7",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "tabby-core": "^1.0.163",
    "tabby-settings": "^1.0.163",
    "tabby-terminal": "^1.0.163",
    "ts-loader": "^9.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
